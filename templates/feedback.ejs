<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Feedback List</title>
  <style>
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
    th { background-color: #f2f2f2; }
    nav a { margin-right: 15px; text-decoration: none; color: #0066cc; }
    nav a:hover { text-decoration: underline; }
    nav { margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid #ccc; }
  </style>
</head>
<body>
  <%- include('partials/nav') %>

  <h1>Feedback List</h1>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Arrived</th>
        <th>From User</th>
        <th>Guest Name</th>
        <th>Guest Email</th>
        <th>Feedback</th>
        <th>Handled</th>
      </tr>
    </thead>
    <tbody>
      <% feedback.forEach(function(f) { %>
        <tr>
          <td><%= f.id %></td>
          <td>
            <%= f.arrived
              ? new Date(f.arrived).toLocaleString('fi-FI')
              : '-' %>
          </td>
          <td>
            <% if (f.from_user) { %>
              <%= f.user_fullname %>
            <% } else { %>
              -
            <% } %>
          </td>
          <td><%= f.guest_name || '-' %></td>
          <td><%= f.guest_email || '-' %></td>
          <td><%= f.feedback %></td>
          <td>
            <%= f.handled
              ? new Date(f.handled).toLocaleString('fi-FI')
              : '-' %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>