<%- include('partials/header') %>
<%- include('partials/nav') %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Feedback List</title>
  <style>
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background: #f2f2f2; }
  </style>
</head>
<body>
  <h1>Feedback List</h1>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Arrived</th>
        <th>From User</th>
        <th>Guest Name</th>
        <th>Guest Email</th>
        <th>Feedback</th>
        <th>Handled</th>
      </tr>
    </thead>
    <tbody>
      <% feedback.forEach(f => { %>
        <tr>
          <td><%= f.id %></td>
          <td><%= f.arrived %></td>
          <td><%= f.from_user || "-" %></td>
          <td><%= f.guest_name || "-" %></td>
          <td><%= f.guest_email || "-" %></td>
          <td><%= f.feedback %></td>
          <td><%= f.handled || "-" %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
<%- include('partials/footer') %>